<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/trainingFragment">

    <fragment
        android:id="@+id/trainingFragment"
        android:name="com.fit.fitnessapp.main.MainFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_trainingFragment_to_exListFragment"
            app:destination="@id/exListFragment" />
    </fragment>

    <fragment
        android:id="@+id/trainingListFragment"
        android:name="com.fit.fitnessapp.exercises.ui.training.TrainingFragment"
        android:label="@string/trainingDays"
        tools:layout="@layout/fragment_training">
        <argument
            android:name="difficulty"
            app:argType="string"
            android:defaultValue="easy" />
        <action
            android:id="@+id/action_trainingFragment_to_exListFragment"
            app:destination="@id/exListFragment" />
    </fragment>
    <fragment
        android:id="@+id/exerciseFragment"
        android:name="com.fit.fitnessapp.exercises.ui.exercise.ExerciseFragment"
        android:label="ExerciseFragment"
        tools:layout="@layout/exercise"
        >
        <action
            android:id="@+id/action_exerciseFragment_to_daysFinishFragment"
            app:destination="@id/daysFinishFragment" />
    </fragment>
    <fragment
        android:id="@+id/exListFragment"
        android:name="com.fit.fitnessapp.exercises.ui.exerciseList.ExerciseListFragment"
        android:label="ExListFragment"
        tools:layout="@layout/exercise_list_fragment"
        >
        <action
            android:id="@+id/action_exListFragment_to_exerciseFragment"
            app:destination="@id/exerciseFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.fit.fitnessapp.settings.ui.SettingsFragment"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/statisticFragment"
        android:name="com.fit.fitnessapp.statistic.ui.StatisticFragment"
        tools:layout="@layout/fragment_statistic" />
    <fragment
        android:id="@+id/customDaysListFragment"
        android:name="com.fit.fitnessapp.customTraining.ui.customDaysList.CustomDaysListFragment"
        android:label="Своя тренировка"
        tools:layout="@layout/fragment_custom_days_list" />
    <fragment
        android:id="@+id/selectedExerciseListFragment"
        android:name="com.fit.fitnessapp.customTraining.ui.selectedExerciseList.SelectedExerciseListFragment"
        android:label="fragment_selected_exercise_list"
        tools:layout="@layout/fragment_selected_exercise_list" />
    <fragment
        android:id="@+id/chooseExercisesFragment"
        android:name="com.fit.fitnessapp.customTraining.ui.chooseExercises.ChooseExercisesFragment"
        android:label="Выбор упражнений"
        tools:layout="@layout/fragment_choose_exercises"
        />
    <fragment
        android:id="@+id/daysFinishFragment"
        android:name="com.fit.fitnessapp.statistic.ui.DaysFinishFragment"
        android:label="DaysFinishFragment"
        tools:layout="@layout/finish"

        />
</navigation>